{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "strict": false,
    "paths": {
      "*": [
        "node_modules/*"
      ]
    }
  },
  "exclude":  [
    "node_modules",
    "**/*.spec.ts"
  ]
}